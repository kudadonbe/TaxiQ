rules_version = '2';

// TaxiQ Firestore security rules.
//
// Sign-in is Google accounts via Firebase Auth (an MDS exception: the standard requires eFaas; see
// SECURITY.md). Roles come from roles/{email}, written by an admin:
//   admin     everything below, plus taxis and staff
//   operator  the queue, dispatches and passenger requests
//   driver    linked to one taxi (taxiId): sees offers for that taxi, accepts or declines them
//   dev       full access for development/testing: everything an admin can do, and can act as the
//             driver of any taxi (sets its own taxiId)
// Any other signed-in Google account is a passenger: it can request rides, nothing else.
// Signed-out visitors can only read publicTaxis (the map).
//
// There is no server: these rules are the referee for ride offers. They enforce the 20-second
// offer timeout with the server clock, that only the offered driver can accept, and that an
// accepting driver can only move their own taxi to the back of the queue. They can't check that the
// next taxi offered is the right one in queue order (no loops in rules); see SECURITY.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function roleDoc() {
      return /databases/$(database)/documents/roles/$(email());
    }
    function role() {
      return signedIn() && exists(roleDoc()) ? get(roleDoc()).data.role : '';
    }
    function isAdmin() {
      return role() in ['admin', 'dev'];
    }
    function isStaff() {
      return role() in ['admin', 'operator', 'dev'];
    }
    function isDriver() {
      return role() in ['driver', 'dev'] && myTaxi() != '';
    }
    function myTaxi() {
      return role() in ['driver', 'dev'] ? get(roleDoc()).data.get('taxiId', '') : '';
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function queueOrder() {
      return get(/databases/$(database)/documents/queue/state).data.order;
    }

    match /roles/{userEmail} {
      // Only a dev may give, change or remove the dev role (an admin can't make themselves dev).
      function touchesDev() {
        return (resource != null && resource.data.role == 'dev')
          || (request.resource != null && request.resource.data.role == 'dev');
      }
      allow read: if signedIn() && (userEmail == email() || isAdmin());
      allow create, update: if isAdmin()
        && (!touchesDev() || role() == 'dev')
        && request.resource.data.keys().hasOnly(['role', 'taxiId', 'addedBy', 'addedAt'])
        && request.resource.data.role in ['admin', 'operator', 'driver', 'private', 'dev']
        && (request.resource.data.role != 'driver' || str(request.resource.data.taxiId, 40))
        && userEmail == userEmail.lower();
      // Nobody removes their own entry (avoids locking everyone out).
      allow delete: if isAdmin() && userEmail != email() && (!touchesDev() || role() == 'dev');
    }

    // Everyone who has signed in: written by the person themselves on sign-in; readable by admins
    // (and devs) to see and manage all users. Holds no more than email, name and when.
    // Citizens showing themselves on the map: opt-in, written only by the person, deleted when they
    // stop, and hidden by readers after 2 minutes without an update or after its hour (src/core/presence.ts).
    // presence/{uid}: with their name, for drivers and centers (staff) only.
    // presencePublic/{uid}: no name, only when they chose everyone signed in.
    function presenceShape(d) {
      return d.at is list && d.at.size() == 2 && d.at[0] is number && d.at[1] is number
        && d.mode in ['walk', 'run', 'bike', 'ebike', 'motorbike', 'taxi']
        && d.modeAuto is bool
        && d.get('level', 'active') in ['active', 'rest', 'nap', 'sleep']
        && d.updatedAt == request.time
        && d.expiresAt is timestamp && d.expiresAt <= request.time + duration.value(61, 'm');
    }
    match /presence/{uid} {
      allow read: if isStaff() || isDriver() || (signedIn() && uid == request.auth.uid);
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'at', 'mode', 'modeAuto', 'level', 'visibility', 'updatedAt', 'expiresAt'])
        && str(request.resource.data.name, 80)
        && request.resource.data.visibility in ['staff', 'public']
        && presenceShape(request.resource.data);
      allow delete: if signedIn() && uid == request.auth.uid;
    }
    match /presencePublic/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['at', 'mode', 'modeAuto', 'level', 'updatedAt', 'expiresAt'])
        && presenceShape(request.resource.data);
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /users/{uid} {
      function profile() {
        return request.resource.data;
      }
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid
        && profile().keys().hasOnly(['email', 'name', 'createdAt', 'lastSeen'])
        && profile().email == email()
        && str(profile().name, 80)
        && profile().createdAt == request.time
        && profile().lastSeen == request.time;
      allow update: if signedIn() && uid == request.auth.uid
        && profile().keys().hasOnly(['email', 'name', 'createdAt', 'lastSeen'])
        && profile().email == email()
        && str(profile().name, 80)
        && profile().createdAt == resource.data.createdAt
        && profile().lastSeen == request.time;
    }

    // Full taxi records, including driver phone numbers: staff, and each driver for their own taxi.
    match /taxis/{taxiId} {
      allow read: if isStaff() || (isDriver() && taxiId == myTaxi());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['taxiNo', 'taxiReg', 'driver', 'suspended'])
        && str(request.resource.data.taxiNo, 4)
        && str(request.resource.data.taxiReg, 7)
        && request.resource.data.driver is map
        && str(request.resource.data.driver.name, 60)
        && str(request.resource.data.driver.nameDv, 60)
        && str(request.resource.data.driver.phone, 7);
      allow delete: if isAdmin();
    }

    // What the public map shows: no phone numbers. Kept in step with taxis by the admin screens.
    // ---- Private vehicles for hire (people and companies, not a center's queue). The owner applies
    // (status pending); any operator approves, rejects or suspends with a reason; every decision is
    // logged (vehicleLog, append-only). The owner sets their price. While an approved vehicle is
    // available, its owner's device shows it on the map (publicVehicles, no phone number).
    function vehicleDetails(d) {
      return d.type in ['car', 'van', 'pickup', 'motorbike', 'ebike']
        && str(d.reg, 12) && d.reg.size() > 0
        && str(d.colour, 24)
        && d.seats is int && d.seats >= 1 && d.seats <= 20
        && d.priceBase is number && d.priceBase >= 0 && d.priceBase <= 10000
        && d.pricePerKm is number && d.pricePerKm >= 0 && d.pricePerKm <= 1000
        && d.phone is string && d.phone.matches('^[0-9]{7}$')
        && str(d.ownerName, 80)
        && str(d.note, 120)
        && d.get('rider', 'none') in ['none', 'man', 'woman', 'young'];
    }
    function vehicleKeys() {
      return ['ownerUid', 'ownerName', 'kind', 'type', 'reg', 'colour', 'seats', 'priceBase', 'pricePerKm', 'phone', 'note', 'rider',
        'status', 'reason', 'decidedBy', 'decidedAt', 'createdAt', 'updatedAt'];
    }
    match /vehicles/{vehicleId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(vehicleKeys())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind == 'private'
        && request.resource.data.status == 'pending' && request.resource.data.reason == ''
        && request.resource.data.decidedBy == null && request.resource.data.decidedAt == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && vehicleDetails(request.resource.data);
      allow update: if signedIn() && request.resource.data.keys().hasOnly(vehicleKeys()) && (
        // The owner edits details while pending or rejected (sending it back for approval), or only
        // the price once approved. Never the decision.
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.decidedBy == resource.data.decidedBy
          && request.resource.data.decidedAt == resource.data.decidedAt
          && request.resource.data.updatedAt == request.time
          && vehicleDetails(request.resource.data)
          && ((resource.data.status in ['pending', 'rejected'] && request.resource.data.status == 'pending' && request.resource.data.reason == '')
            || (resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priceBase', 'pricePerKm', 'rider', 'updatedAt']))))
        // Any operator decides: approve, reject or suspend, with a reason; nothing else changes.
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'decidedBy', 'decidedAt', 'updatedAt'])
          && request.resource.data.status in ['approved', 'rejected', 'suspended']
          && str(request.resource.data.reason, 120)
          && (request.resource.data.status == 'approved' || request.resource.data.reason.size() > 0)
          && request.resource.data.decidedBy == email()
          && request.resource.data.decidedAt == request.time
          && request.resource.data.updatedAt == request.time));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status in ['pending', 'rejected'];
    }
    // Every application and decision, kept for good.
    match /vehicleLog/{logId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['vehicleId', 'ownerUid', 'action', 'by', 'reason', 'at'])
        && request.resource.data.action in ['applied', 'edited', 'approved', 'rejected', 'suspended', 'withdrawn']
        && str(request.resource.data.reason, 120)
        && request.resource.data.at == request.time
        && request.resource.data.by == email()
        && (request.resource.data.action in ['applied', 'edited', 'withdrawn']
          ? request.resource.data.ownerUid == request.auth.uid
          : isStaff());
      allow update, delete: if false;
    }
    // Booking a private vehicle (one at a time per passenger: privateRides/{passengerUid}). Only the
    // passenger, the vehicle's owner and staff see it. Only an approved vehicle on the map can be
    // booked. The owner accepts or declines, then marks picked up and done; the passenger can cancel.
    function rideKeys() {
      return ['uid', 'name', 'phone', 'vehicleId', 'ownerUid', 'ownerFirstName', 'ownerPhone', 'pickup', 'pickupAt', 'destination', 'destinationAt',
        'note', 'price', 'status', 'createdAt', 'updatedAt'];
    }
    match /privateRides/{uid} {
      allow read: if isStaff() || (signedIn() && (uid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(rideKeys()) && (
        // The passenger books (or books again, replacing a finished one).
        (uid == request.auth.uid
          && (resource == null || resource.data.status in ['declined', 'cancelled', 'done'])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'offering'
          && str(request.resource.data.name, 80)
          && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{7}$')
          && str(request.resource.data.pickup, 120) && request.resource.data.pickup.size() > 0
          && str(request.resource.data.destination, 120) && str(request.resource.data.note, 120)
          && request.resource.data.pickupAt is list && request.resource.data.pickupAt.size() == 2
          && (request.resource.data.destinationAt == null || (request.resource.data.destinationAt is list && request.resource.data.destinationAt.size() == 2))
          && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 100000
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.ownerUid
          && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status == 'approved'
          && exists(/databases/$(database)/documents/publicVehicles/$(request.resource.data.vehicleId))
          && request.resource.data.ownerUid != request.auth.uid
          && request.resource.data.ownerFirstName == '' && request.resource.data.ownerPhone == ''
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time)
        // The passenger cancels before the trip starts.
        || (resource != null && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status in ['offering', 'accepted'] && request.resource.data.status == 'cancelled'
          && request.resource.data.updatedAt == request.time)
        // The owner answers and moves the trip on: offering -> accepted (with their name and phone)
        // or declined; accepted -> onboard; onboard -> done.
        || (resource != null && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerFirstName', 'ownerPhone', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((resource.data.status == 'offering' && request.resource.data.status == 'accepted' && role() in ['private', 'dev']
                && str(request.resource.data.ownerFirstName, 40)
                && request.resource.data.ownerPhone is string && request.resource.data.ownerPhone.matches('^[0-9]{7}$'))
            || (resource.data.status == 'offering' && request.resource.data.status == 'declined')
            || (resource.data.status == 'accepted' && request.resource.data.status == 'onboard')
            || (resource.data.status == 'onboard' && request.resource.data.status == 'done'))));
      allow delete: if false;
    }

    // An approved vehicle on the map while its owner has it available: no phone number.
    match /publicVehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.status == 'approved'
        && request.resource.data.keys().hasOnly(['ownerUid', 'type', 'colour', 'seats', 'firstName', 'priceBase', 'pricePerKm', 'at', 'heading', 'level', 'rider', 'updatedAt'])
        && request.resource.data.get('rider', 'none') in ['none', 'man', 'woman', 'young']
        && request.resource.data.get('level', 'active') in ['active', 'rest', 'nap', 'sleep']
        && request.resource.data.ownerUid == request.auth.uid
        // Two checks: the person has the Private driver role, and the vehicle is approved.
        && role() in ['private', 'dev']
        && request.resource.data.type in ['car', 'van', 'pickup', 'motorbike', 'ebike']
        && str(request.resource.data.firstName, 40)
        && request.resource.data.at is list && request.resource.data.at.size() == 2
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (isStaff()
        || get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerUid == request.auth.uid);
    }

    match /publicTaxis/{taxiId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['taxiNo', 'name', 'nameDv', 'suspended'])
        && str(request.resource.data.taxiNo, 4)
        && str(request.resource.data.name, 60)
        && str(request.resource.data.nameDv, 60)
        && request.resource.data.suspended is bool;
      allow delete: if isAdmin();
    }

    match /queue/state {
      // The order is a list of taxi ids (not personal data); passengers and drivers need it for offers.
      allow read: if signedIn();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['order', 'interested', 'updatedAt', 'updatedBy'])
        && request.resource.data.order is list && request.resource.data.order.size() <= 500
        && request.resource.data.interested is list && request.resource.data.interested.size() <= 500;
      // A driver who accepted a ride moves their own taxi to the back, and nothing else.
      allow update: if isDriver()
        && request.resource.data.keys().hasOnly(['order', 'interested', 'updatedAt', 'updatedBy'])
        && request.resource.data.order == resource.data.order.removeAll([myTaxi()]).concat([myTaxi()])
        && request.resource.data.interested == resource.data.interested.removeAll([myTaxi()]);
    }

    match /dispatches/{dispatchId} {
      allow read: if isStaff();
      allow create: if (isStaff() || (isDriver() && request.resource.data.taxi.id == myTaxi()))
        && request.resource.data.keys().hasOnly(['taxi', 'at', 'from', 'interested', 'call', 'reopened', 'undone', 'by', 'requestId'])
        && request.resource.data.at is int
        && request.resource.data.from is int
        && request.resource.data.reopened == false
        && request.resource.data.undone == false;
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['taxi', 'at', 'from', 'interested', 'call', 'reopened', 'undone', 'by', 'requestId'])
        && request.resource.data.at is int
        && request.resource.data.from is int;
    }

    // One ride request per passenger: requests/{their uid}. A new request overwrites the old one.
    match /requests/{uid} {
      function next() {
        return request.resource.data;
      }
      function prev() {
        return resource.data;
      }
      function validShape() {
        return next().keys().hasOnly(['uid', 'name', 'mode', 'pickup', 'pickupAt', 'destination', 'destinationAt', 'phone', 'note',
            'status', 'offerTo', 'offerAt', 'skipped', 'acceptedBy', 'createdAt'])
          && next().uid == uid
          && str(next().name, 80)
          && next().mode in ['queue', 'direct']
          && str(next().pickup, 120) && next().pickup.size() > 0
          && str(next().destination, 120)
          && next().phone is string && next().phone.matches('^[0-9]{7}$')
          && str(next().note, 120)
          && (!('pickupAt' in next()) || (next().pickupAt is list && next().pickupAt.size() == 2))
          && (!('destinationAt' in next()) || (next().destinationAt is list && next().destinationAt.size() == 2))
          && next().status in ['offering', 'accepted', 'expired', 'cancelled']
          && (next().offerTo == null || str(next().offerTo, 40))
          && next().offerAt is timestamp
          && next().skipped is list && next().skipped.size() <= 500
          && (next().acceptedBy == null || str(next().acceptedBy, 40));
      }
      // A fresh request: offered to one taxi (or nobody, if no taxi is free), just now.
      function isFresh() {
        return next().status in ['offering', 'expired']
          && next().offerAt == request.time
          && next().createdAt == request.time
          && next().skipped.size() == 0
          && next().acceptedBy == null
          && (next().status == 'expired' || next().offerTo in queueOrder());
      }
      function sameTrip() {
        return next().uid == prev().uid && next().name == prev().name && next().mode == prev().mode
          && next().pickup == prev().pickup && next().destination == prev().destination
          && next().phone == prev().phone && next().note == prev().note
          && next().createdAt == prev().createdAt
          && next().get('pickupAt', null) == prev().get('pickupAt', null);
      }
      // Move the offer on from the current taxi (declined or timed out) to the next, or expire.
      function movesOn() {
        return prev().status == 'offering'
          && sameTrip()
          && next().skipped == prev().skipped.concat([prev().offerTo])
          && next().offerAt == request.time
          && next().acceptedBy == null
          && (
            (next().status == 'expired' && next().offerTo == null)
            || (prev().mode == 'queue' && next().status == 'offering'
                && next().offerTo in queueOrder() && !(next().offerTo in next().skipped))
          );
      }

      allow read: if signedIn() && (uid == request.auth.uid || isStaff()
        || (isDriver() && (resource.data.offerTo == myTaxi() || resource.data.acceptedBy == myTaxi())));

      allow create: if signedIn() && uid == request.auth.uid && validShape() && isFresh();

      allow update: if signedIn() && validShape() && (
        // The passenger: a new request, or cancel.
        (uid == request.auth.uid && (isFresh() || (sameTrip() && next().status == 'cancelled')))
        // Anyone involved, once the offer has waited 20 s: move it on.
        || ((uid == request.auth.uid || isStaff() || isDriver())
            && request.time > prev().offerAt + duration.value(20, 's') && movesOn())
        // The offered driver declines: move it on.
        || (isDriver() && prev().offerTo == myTaxi() && movesOn())
        // The offered driver accepts (taxi must not be suspended).
        || (isDriver() && prev().status == 'offering' && prev().offerTo == myTaxi()
            && !('suspended' in get(/databases/$(database)/documents/taxis/$(myTaxi())).data)
            && sameTrip() && next().status == 'accepted' && next().acceptedBy == myTaxi()
            && next().offerTo == prev().offerTo && next().skipped == prev().skipped && next().offerAt == prev().offerAt)
        // Staff can cancel any request.
        || (isStaff() && sameTrip() && next().status == 'cancelled')
      );
    }

    // Manual queue changes (reorder / shuffle) by staff, each with a reason. A permanent log:
    // anyone on staff can add an entry for themselves, nobody can edit or delete one.
    match /queueChanges/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['at', 'by', 'kind', 'reason', 'note', 'before', 'after'])
        && request.resource.data.at == request.time
        && request.resource.data.by == email()
        && request.resource.data.kind in ['reorder', 'shuffle']
        && request.resource.data.reason in ['late', 'returned', 'correction', 'shift', 'other']
        && str(request.resource.data.note, 120)
        && (request.resource.data.reason != 'other' || request.resource.data.note.size() > 0)
        && request.resource.data.before is list && request.resource.data.before.size() <= 500
        && request.resource.data.after is list && request.resource.data.after.size() == request.resource.data.before.size();
      allow update, delete: if false;
    }

    // ---- TaxiQ Game (plans/game-mode.md). Completely separate from the real service: play money,
    // game cars and players only; nothing here touches taxis, the queue, dispatches or roles.
    // games/world is the shared TaxiQ World: created once by whoever opens it first, always running,
    // nobody can change, pause or end it. Other games are private worlds run by their host.
    function gameDoc(gameId) {
      return getAfter(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function gameKeys() {
      return ['name', 'code', 'seed', 'hostUid', 'hostName', 'status', 'preset', 'bots', 'createdAt', 'startedAt', 'pausedMs', 'pausedAt'];
    }
    // The device that runs a world's ride service holds its lease (games/{id}/engine/lease).
    function isEngine(gameId) {
      let lease = get(/databases/$(database)/documents/games/$(gameId)/engine/lease).data;
      return lease.uid == request.auth.uid && lease.until > request.time;
    }
    function inGame(gameId) {
      return exists(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid));
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(gameKeys())
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && str(request.resource.data.hostName, 80)
        && request.resource.data.code is string && request.resource.data.code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && request.resource.data.seed == gameId
        && request.resource.data.preset in ['small', 'standard', 'large']
        && request.resource.data.bots is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.pausedMs == 0
        && request.resource.data.pausedAt == null
        && (gameId == 'world'
          ? request.resource.data.hostUid == 'world' && request.resource.data.status == 'running'
            && request.resource.data.startedAt == request.time && request.resource.data.bots == true
          : request.resource.data.hostUid == request.auth.uid && request.resource.data.status == 'lobby'
            && request.resource.data.startedAt == null);
      // Only the host changes a private world: start, pause, resume, end. The shared world never changes.
      allow update: if signedIn() && gameId != 'world' && resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(gameKeys())
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['lobby', 'running', 'paused', 'ended']
        && request.resource.data.preset in ['small', 'standard', 'large']
        && request.resource.data.pausedMs is int && request.resource.data.pausedMs >= resource.data.pausedMs;
      allow delete: if false;

      // Each player writes only their own entry: name, role, online, where to wait, heartbeat.
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'joinedAt', 'online', 'waitLat', 'waitLng', 'waitT', 'beatAt'])
          && str(request.resource.data.name, 80)
          && request.resource.data.role in ['citizen', 'driver', 'operator', 'owner']
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.get('online', false) is bool
          && request.resource.data.get('waitT', 0) is number
          && gameDoc(gameId).status in ['lobby', 'running', 'paused'];
        allow delete: if signedIn() && uid == request.auth.uid;
      }

      // The world's people, made once with the world and never made again.
      match /world/{docId} {
        allow read: if signedIn();
        allow create: if signedIn() && docId == 'roster'
          && request.resource.data.keys().hasOnly(['drivers', 'citizens', 'centers'])
          && request.resource.data.drivers is list && request.resource.data.drivers.size() <= 100
          && request.resource.data.citizens is list && request.resource.data.citizens.size() <= 200
          && request.resource.data.centers is list && request.resource.data.centers.size() <= 10
          && (gameId == 'world' || gameDoc(gameId).hostUid == request.auth.uid);
        allow update, delete: if false;
      }

      // Who runs the ride service now. A player of the world (the host, for a private world) takes
      // the lease when it is free or theirs, for up to a minute at a time.
      match /engine/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && docId == 'lease'
          && request.resource.data.keys().hasOnly(['uid', 'until'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.until is timestamp
          && request.resource.data.until <= request.time + duration.value(60, 's')
          && (resource == null || resource.data.uid == request.auth.uid || resource.data.until < request.time)
          && (gameId == 'world' ? inGame(gameId) : gameDoc(gameId).hostUid == request.auth.uid);
        allow delete: if false;
      }

      // Cars: written only by the engine.
      match /cars/{carNo} {
        allow read: if signedIn();
        allow create, update: if signedIn() && isEngine(gameId)
          && carNo.matches('^[0-9]{1,3}$')
          && request.resource.data.keys().hasOnly(['driverUid', 'plan', 'queuedAt', 'waitT'])
          && request.resource.data.plan is map
          && request.resource.data.queuedAt is number;
        allow delete: if false;
      }

      // Money (G3): only the engine writes the money head, wallets and ledger. Everyone in the world
      // can read them (an open economy). Ledger entries are append-only: never changed or deleted.
      match /money/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && isEngine(gameId) && docId == 'state'
          && request.resource.data.keys().hasOnly(['bank', 'island', 'charity', 'outsideIn', 'outsideOut', 'seq', 'lastHash'])
          && request.resource.data.seq is int
          && (resource == null || request.resource.data.seq >= resource.data.seq);
        allow delete: if false;
      }
      match /wallets/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && isEngine(gameId)
          && request.resource.data.keys().hasOnly(['cash', 'job', 'car', 'deals', 'day', 'lastDay'])
          && request.resource.data.cash is number
          && request.resource.data.car in ['none', 'rent', 'own', 'bank'];
        allow delete: if false;
      }
      match /ledger/{seq} {
        allow read: if signedIn();
        allow create: if signedIn() && isEngine(gameId)
          && request.resource.data.keys().hasOnly(['seq', 'day', 'from', 'to', 'amount', 'reason', 'prev', 'hash', 'createdAt'])
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.hash is string && request.resource.data.prev is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      // A player asks for a job, to quit, or a KD-Bank deal; the engine decides.
      match /applications/{appId} {
        allow read: if signedIn();
        allow create: if signedIn() && inGame(gameId)
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'days', 'amount', 'status', 'reason', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['job', 'quit', 'murabaha', 'ijara', 'qard']
          && request.resource.data.days is int && request.resource.data.amount is number
          && request.resource.data.status == 'new' && request.resource.data.reason == ''
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && isEngine(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason'])
          && resource.data.status == 'new'
          && request.resource.data.status in ['approved', 'declined'];
        allow delete: if false;
      }

      // Rides. A player books their own; the engine books bot rides and runs every ride. The driver
      // the ride is offered to only answers it; the rider may cancel while it is still searching.
      match /trips/{tripId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['riderUid', 'riderName', 'bot', 'pLat', 'pLng', 'pName', 'dLat', 'dLng', 'dName', 'status', 'createdT', 'offerCar', 'offerT', 'response', 'declined', 'carNo', 'driverName', 'driverUid', 't0', 'dPick', 'dTotal', 'km', 'fare', 'doneT', 'createdAt'])
          && request.resource.data.status == 'searching'
          && request.resource.data.offerCar == null && request.resource.data.carNo == null && request.resource.data.fare == null
          && request.resource.data.pLat is number && request.resource.data.pLng is number
          && request.resource.data.dLat is number && request.resource.data.dLng is number
          && str(request.resource.data.pName, 80) && str(request.resource.data.dName, 80) && str(request.resource.data.riderName, 80)
          && request.resource.data.createdAt == request.time
          && (request.resource.data.bot == true
            ? isEngine(gameId) && request.resource.data.riderUid == 'bot'
            : request.resource.data.riderUid == request.auth.uid && inGame(gameId));
        allow update: if signedIn() && (
          (isEngine(gameId)
            && request.resource.data.riderUid == resource.data.riderUid
            && request.resource.data.bot == resource.data.bot
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status in ['searching', 'assigned', 'done', 'cancelled', 'expired'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response'])
            && resource.data.status == 'searching'
            && request.resource.data.response in ['accept', 'decline']
            && get(/databases/$(database)/documents/games/$(gameId)/cars/$(string(resource.data.offerCar))).data.driverUid == request.auth.uid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'searching' && request.resource.data.status == 'cancelled'
            && resource.data.riderUid == request.auth.uid));
        allow delete: if false;
      }
    }

    // Join code -> private world. Created once with the world; a taken code fails (create only), so
    // the app tries another.
    match /gameCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && request.resource.data.keys().hasOnly(['gameId', 'hostUid'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.gameId is string
        // The code must point at a game created in the same write, carrying this code and host.
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.code == code
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.hostUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Live Dhivehi translation fixes (Admin → Translations). Everyone reads them (they're UI text);
    // only admins and devs change them. The app renders them as plain text, never as HTML.
    match /translations/{lang} {
      allow read: if lang in ['dv'];
      allow write: if isAdmin() && lang in ['dv']
        && request.resource.data.keys().hasOnly(['entries', 'updatedBy', 'updatedAt'])
        && request.resource.data.entries is map
        && request.resource.data.entries.size() <= 600
        && request.resource.data.updatedBy == email();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
