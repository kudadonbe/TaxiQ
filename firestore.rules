rules_version = '2';

// TaxiQ Firestore security rules.
//
// Sign-in is Google accounts via Firebase Auth (an MDS exception: the standard requires eFaas; see
// SECURITY.md). Roles come from roles/{email}, written by an admin:
//   admin     everything below, plus taxis and staff
//   operator  the queue, dispatches and passenger requests
//   driver    linked to one taxi (taxiId): sees offers for that taxi, accepts or declines them
//   dev       full access for development/testing: everything an admin can do, and can act as the
//             driver of any taxi (sets its own taxiId)
// Any other signed-in Google account is a passenger: it can request rides, nothing else.
// Signed-out visitors can only read publicTaxis (the map).
//
// There is no server: these rules are the referee for ride offers. They enforce the 20-second
// offer timeout with the server clock, that only the offered driver can accept, and that an
// accepting driver can only move their own taxi to the back of the queue. They can't check that the
// next taxi offered is the right one in queue order (no loops in rules); see SECURITY.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function roleDoc() {
      return /databases/$(database)/documents/roles/$(email());
    }
    function role() {
      return signedIn() && exists(roleDoc()) ? get(roleDoc()).data.role : '';
    }
    function isAdmin() {
      return role() in ['admin', 'dev'];
    }
    function isStaff() {
      return role() in ['admin', 'operator', 'dev'];
    }
    function isDriver() {
      return role() in ['driver', 'dev'] && myTaxi() != '';
    }
    function myTaxi() {
      return role() in ['driver', 'dev'] ? get(roleDoc()).data.get('taxiId', '') : '';
    }
    // May offer private hire: the Private driver role, a developer, or a center driver also allowed it.
    function canPrivate() {
      return role() in ['private', 'dev'] || (role() == 'driver' && get(roleDoc()).data.get('private', false) == true);
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }
    // ---- Taxi centers. Each has its own queue, taxis, dispatch log, fare table and staff. The first
    // center is 'main' (everything from before centers; records without a centerId belong to it):
    // its queue is queue/state, the others' queues/{center}. Platform admins (an admin entry with no
    // centerId, or a developer) manage every center; a center admin or operator only their own.
    function myCenter() {
      return signedIn() && exists(roleDoc()) ? get(roleDoc()).data.get('centerId', 'main') : '';
    }
    function isPlatform() {
      return role() == 'dev' || (role() == 'admin' && !('centerId' in get(roleDoc()).data));
    }
    function staffOf(c) {
      return isPlatform() || (role() in ['admin', 'operator'] && myCenter() == c);
    }
    function adminOf(c) {
      return isPlatform() || (role() == 'admin' && myCenter() == c);
    }
    function queueOf(c) {
      return c == 'main' ? /databases/$(database)/documents/queue/state : /databases/$(database)/documents/queues/$(c);
    }
    function queueOrder(c) {
      return get(queueOf(c)).data.order;
    }

    match /roles/{userEmail} {
      // Only a dev may give, change or remove the dev role (an admin can't make themselves dev).
      function touchesDev() {
        return (resource != null && resource.data.role == 'dev')
          || (request.resource != null && request.resource.data.role == 'dev');
      }
      allow read: if signedIn() && (userEmail == email() || isAdmin());
      // A center admin gives and changes roles only within their own center (and the Private
      // driver role, which has no center), and never touches a platform admin.
      function platformEntry(d) {
        return d.role == 'dev' || (d.role == 'admin' && !('centerId' in d));
      }
      function centerAdminMay() {
        return role() == 'admin'
          && (request.resource == null
            || (request.resource.data.role in ['admin', 'operator', 'driver'] && request.resource.data.get('centerId', '') == myCenter())
            || (request.resource.data.role == 'private' && !('centerId' in request.resource.data)))
          && (resource == null || (!platformEntry(resource.data)
            && (resource.data.role == 'private' || resource.data.get('centerId', 'main') == myCenter())));
      }
      allow create, update: if isAdmin()
        && (!touchesDev() || role() == 'dev')
        && (isPlatform() || centerAdminMay())
        && request.resource.data.keys().hasOnly(['role', 'taxiId', 'private', 'centerId', 'corpus', 'addedBy', 'addedAt'])
        // Corpus editor (Dhivehi corpus): given or taken away by platform admins only.
        && request.resource.data.get('corpus', false) is bool
        && (isPlatform() || request.resource.data.get('corpus', false) == (resource == null ? false : resource.data.get('corpus', false)))
        && (!('centerId' in request.resource.data) || str(request.resource.data.centerId, 40))
        && request.resource.data.get('private', false) is bool
        && request.resource.data.role in ['admin', 'operator', 'driver', 'private', 'dev']
        && (request.resource.data.role != 'driver' || str(request.resource.data.taxiId, 40))
        && userEmail == userEmail.lower();
      // Nobody removes their own entry (avoids locking everyone out).
      allow delete: if isAdmin() && userEmail != email() && (!touchesDev() || role() == 'dev') && (isPlatform() || centerAdminMay());
    }

    // Everyone who has signed in: written by the person themselves on sign-in; readable by admins
    // (and devs) to see and manage all users. Holds no more than email, name and when.
    // Citizens showing themselves on the map: opt-in, written only by the person, deleted when they
    // stop, and hidden by readers after 2 minutes without an update or after its hour (src/core/presence.ts).
    // presence/{uid}: with their name, for drivers and centers (staff) only.
    // presencePublic/{uid}: no name, only when they chose everyone signed in.
    function presenceShape(d) {
      return d.at is list && d.at.size() == 2 && d.at[0] is number && d.at[1] is number
        && d.mode in ['walk', 'run', 'bike', 'ebike', 'motorbike', 'taxi']
        && d.modeAuto is bool
        && d.get('level', 'active') in ['active', 'rest', 'nap', 'sleep']
        && d.updatedAt == request.time
        && d.expiresAt is timestamp && d.expiresAt <= request.time + duration.value(61, 'm');
    }
    match /presence/{uid} {
      allow read: if isStaff() || isDriver() || (signedIn() && uid == request.auth.uid);
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'at', 'mode', 'modeAuto', 'level', 'visibility', 'updatedAt', 'expiresAt'])
        && str(request.resource.data.name, 80)
        && request.resource.data.visibility in ['staff', 'public']
        && presenceShape(request.resource.data);
      allow delete: if signedIn() && uid == request.auth.uid;
    }
    match /presencePublic/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['at', 'mode', 'modeAuto', 'level', 'updatedAt', 'expiresAt'])
        && presenceShape(request.resource.data);
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /users/{uid} {
      function profile() {
        return request.resource.data;
      }
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid
        && profile().keys().hasOnly(['email', 'name', 'createdAt', 'lastSeen'])
        && profile().email == email()
        && str(profile().name, 80)
        && profile().createdAt == request.time
        && profile().lastSeen == request.time;
      allow update: if signedIn() && uid == request.auth.uid
        && profile().keys().hasOnly(['email', 'name', 'createdAt', 'lastSeen'])
        && profile().email == email()
        && str(profile().name, 80)
        && profile().createdAt == resource.data.createdAt
        && profile().lastSeen == request.time;
    }

    // Full taxi records, including driver phone numbers: staff, and each driver for their own taxi.
    match /taxis/{taxiId} {
      // Its center's staff (platform admins: every center); a driver, their own taxi.
      allow read: if isPlatform() || staffOf(resource.data.centerId) || (isDriver() && taxiId == myTaxi());
      allow create, update: if adminOf(request.resource.data.get('centerId', 'main'))
        && (resource == null || adminOf(resource.data.get('centerId', 'main')))
        && request.resource.data.keys().hasOnly(['taxiNo', 'taxiReg', 'driver', 'suspended', 'seats', 'vehicleId', 'centerId'])
        && (!('centerId' in request.resource.data) || str(request.resource.data.centerId, 40))
        && (!('vehicleId' in request.resource.data) || str(request.resource.data.vehicleId, 40))
        && (!('seats' in request.resource.data) || (request.resource.data.seats is int && request.resource.data.seats >= 1 && request.resource.data.seats <= 15))
        && str(request.resource.data.taxiNo, 4)
        && str(request.resource.data.taxiReg, 7)
        && request.resource.data.driver is map
        && str(request.resource.data.driver.name, 60)
        && str(request.resource.data.driver.nameDv, 60)
        && str(request.resource.data.driver.phone, 7);
      allow delete: if adminOf(resource.data.get('centerId', 'main'));
    }

    // What the public map shows: no phone numbers. Kept in step with taxis by the admin screens.
    // ---- Private vehicles for hire (people and companies, not a center's queue). The owner applies
    // (status pending); any operator approves, rejects or suspends with a reason; every decision is
    // logged (vehicleLog, append-only). The owner sets their price. While an approved vehicle is
    // available, its owner's device shows it on the map (publicVehicles, no phone number).
    function vehicleDetails(d) {
      return d.type in ['car', 'van', 'pickup', 'motorbike', 'ebike']
        && str(d.reg, 12) && d.reg.size() > 0
        && str(d.colour, 24)
        && d.seats is int && d.seats >= 1 && d.seats <= 20
        && d.priceBase is number && d.priceBase >= 0 && d.priceBase <= 10000
        && d.pricePerKm is number && d.pricePerKm >= 0 && d.pricePerKm <= 1000
        && d.phone is string && d.phone.matches('^[0-9]{7}$')
        && str(d.ownerName, 80)
        && str(d.note, 120)
        && d.get('rider', 'none') in ['none', 'man', 'woman', 'young'];
    }
    function vehicleKeys() {
      return ['ownerUid', 'ownerName', 'kind', 'type', 'reg', 'colour', 'seats', 'priceBase', 'pricePerKm', 'phone', 'note', 'rider',
        'status', 'reason', 'decidedBy', 'decidedAt', 'createdAt', 'updatedAt', 'taxiId', 'taxiRequest'];
    }
    match /vehicles/{vehicleId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(vehicleKeys())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind == 'private'
        && request.resource.data.status == 'pending' && request.resource.data.reason == ''
        && request.resource.data.decidedBy == null && request.resource.data.decidedAt == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && vehicleDetails(request.resource.data);
      allow update: if signedIn() && request.resource.data.keys().hasOnly(vehicleKeys()) && (
        // The owner edits details while pending or rejected (sending it back for approval), or only
        // the price once approved. Never the decision.
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.decidedBy == resource.data.decidedBy
          && request.resource.data.decidedAt == resource.data.decidedAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.get('taxiId', null) == resource.data.get('taxiId', null)
          && vehicleDetails(request.resource.data)
          && ((resource.data.status in ['pending', 'rejected'] && request.resource.data.status == 'pending' && request.resource.data.reason == '')
            // Approved: price, rider, colour, phone and note change straight away; anything else
            // (registration, type, seats) sends it back to Pending for an operator to check.
            || (resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priceBase', 'pricePerKm', 'rider', 'colour', 'phone', 'note', 'updatedAt']))
            || (resource.data.status == 'approved' && request.resource.data.status == 'pending' && request.resource.data.reason == ''
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'reg', 'seats', 'colour', 'phone', 'note', 'priceBase', 'pricePerKm', 'rider', 'status', 'reason', 'updatedAt']))
            // Approved: ask to run it as a center taxi too (or take the request back).
            || (resource.data.status == 'approved' && resource.data.get('taxiId', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taxiRequest', 'updatedAt'])
              && (request.resource.data.taxiRequest == null
                || (request.resource.data.taxiRequest.keys().hasOnly(['at']) && request.resource.data.taxiRequest.at == request.time)))))
        // An admin links it to the center as a taxi (or answers no to the request).
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taxiId', 'taxiRequest', 'updatedAt'])
          && request.resource.data.get('taxiRequest', null) == null
          && (request.resource.data.get('taxiId', null) == null || str(request.resource.data.taxiId, 40))
          && request.resource.data.updatedAt == request.time)
        // Any operator decides: approve, reject or suspend, with a reason; nothing else changes.
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'decidedBy', 'decidedAt', 'updatedAt'])
          && request.resource.data.status in ['approved', 'rejected', 'suspended']
          && str(request.resource.data.reason, 120)
          && (request.resource.data.status == 'approved' || request.resource.data.reason.size() > 0)
          && request.resource.data.decidedBy == email()
          && request.resource.data.decidedAt == request.time
          && request.resource.data.updatedAt == request.time));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status in ['pending', 'rejected'];
    }
    // Every application and decision, kept for good.
    match /vehicleLog/{logId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['vehicleId', 'ownerUid', 'action', 'by', 'reason', 'at'])
        && request.resource.data.action in ['applied', 'edited', 'approved', 'rejected', 'suspended', 'withdrawn', 'linked']
        && str(request.resource.data.reason, 120)
        && request.resource.data.at == request.time
        && request.resource.data.by == email()
        && (request.resource.data.action in ['applied', 'edited', 'withdrawn']
          ? request.resource.data.ownerUid == request.auth.uid
          : isStaff());
      allow update, delete: if false;
    }
    // Booking a private vehicle (one at a time per passenger: privateRides/{passengerUid}). Only the
    // passenger, the vehicle's owner and staff see it. Only an approved vehicle on the map can be
    // booked. The owner accepts or declines, then marks picked up and done; the passenger can cancel.
    function rideKeys() {
      return ['uid', 'name', 'phone', 'vehicleId', 'ownerUid', 'ownerFirstName', 'ownerPhone', 'pickup', 'pickupAt', 'destination', 'destinationAt',
        'note', 'price', 'km', 'status', 'mode', 'skipped', 'offerAt', 'arrivedAt', 'createdAt', 'updatedAt'];
    }
    // A vehicle that may be offered a trip: approved, on the map, owned as stated, not the passenger's.
    function bookable(vehicleId, ownerUid, passengerUid) {
      return ownerUid == get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerUid
        && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.status == 'approved'
        && exists(/databases/$(database)/documents/publicVehicles/$(vehicleId))
        && ownerUid != passengerUid;
    }
    // Open trips by private hire: how long the current step may wait.
    function privWaited(d) {
      return (d.status == 'offering' && request.time > d.offerAt + duration.value(20, 's'))
        || (d.status == 'interest' && request.time > d.offerAt + duration.value(60, 's'))
        || (d.status == 'confirmed' && request.time > d.offerAt + duration.value(30, 's'));
    }
    match /privateRides/{uid} {
      allow read: if isStaff() || (signedIn() && (uid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(rideKeys()) && (
        // The passenger books (or books again, replacing a finished one).
        (uid == request.auth.uid
          && (resource == null || resource.data.status in ['declined', 'cancelled', 'done', 'expired'])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'offering'
          && request.resource.data.get('mode', 'direct') in ['direct', 'queue']
          && request.resource.data.get('skipped', []) == []
          && request.resource.data.get('offerAt', request.time) == request.time
          && (request.resource.data.get('km', null) == null || (request.resource.data.km is number && request.resource.data.km >= 0 && request.resource.data.km <= 1000))
          && !('arrivedAt' in request.resource.data)
          && str(request.resource.data.name, 80)
          && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{7}$')
          && str(request.resource.data.pickup, 120) && request.resource.data.pickup.size() > 0
          && str(request.resource.data.destination, 120) && str(request.resource.data.note, 120)
          && request.resource.data.pickupAt is list && request.resource.data.pickupAt.size() == 2
          && (request.resource.data.destinationAt == null || (request.resource.data.destinationAt is list && request.resource.data.destinationAt.size() == 2))
          && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 100000
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.ownerUid
          && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status == 'approved'
          && exists(/databases/$(database)/documents/publicVehicles/$(request.resource.data.vehicleId))
          && request.resource.data.ownerUid != request.auth.uid
          && request.resource.data.ownerFirstName == '' && request.resource.data.ownerPhone == ''
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time)
        // The passenger cancels before the trip starts.
        || (resource != null && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status in ['offering', 'interest', 'confirmed', 'accepted'] && request.resource.data.status == 'cancelled'
          && request.resource.data.updatedAt == request.time)
        // Staff cancel a stuck booking at any step before it's finished.
        || (resource != null && request.resource.data.status == 'cancelled'
          && resource.data.status in ['offering', 'interest', 'confirmed', 'accepted', 'onboard', 'arrived']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && isStaff())
        // At the destination: the passenger confirms it finished, or reports a problem. With no
        // answer in 10 minutes, the passenger or the owner marks it done. Staff close a problem.
        || (resource != null && resource.data.status == 'arrived'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((uid == request.auth.uid && request.resource.data.status in ['done', 'problem'])
            || (request.resource.data.status == 'done' && (uid == request.auth.uid || resource.data.ownerUid == request.auth.uid || isStaff())
              && request.time > resource.data.arrivedAt + duration.value(10, 'm'))))
        || (resource != null && resource.data.status == 'problem' && isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'done' && request.resource.data.updatedAt == request.time)
        // Open trip: the passenger books the vehicle that offered.
        || (resource != null && uid == request.auth.uid && resource.data.get('mode', 'direct') == 'queue'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'offerAt', 'updatedAt'])
          && resource.data.status == 'interest' && request.resource.data.status == 'confirmed'
          && request.resource.data.offerAt == request.time && request.resource.data.updatedAt == request.time)
        // Open trip: on to the next vehicle in the private queue, or expired. The passenger, when
        // saying no thanks or after the step's time; the offered owner, when passing.
        || (resource != null && resource.data.get('mode', 'direct') == 'queue'
          && resource.data.status in ['offering', 'interest', 'confirmed']
          && ((uid == request.auth.uid && (resource.data.status == 'interest' || privWaited(resource.data)))
            || (resource.data.ownerUid == request.auth.uid && resource.data.status == 'offering'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vehicleId', 'ownerUid', 'price', 'skipped', 'offerAt', 'status', 'updatedAt'])
          && request.resource.data.skipped == resource.data.skipped.concat([resource.data.vehicleId])
          && request.resource.data.skipped.size() <= 200
          && request.resource.data.offerAt == request.time && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'expired'
            || (request.resource.data.status == 'offering'
              && !(request.resource.data.vehicleId in request.resource.data.skipped)
              && bookable(request.resource.data.vehicleId, request.resource.data.ownerUid, uid)
              && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 100000)))
        // The owner answers and moves the trip on: offering -> accepted (with their name and phone)
        // or declined; accepted -> onboard; onboard -> done.
        || (resource != null && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerFirstName', 'ownerPhone', 'offerAt', 'arrivedAt', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          // A vehicle picked on the map: accept from offering. An open trip: only once booked.
          && ((((resource.data.get('mode', 'direct') == 'direct' && resource.data.status == 'offering')
                  || (resource.data.get('mode', 'direct') == 'queue' && resource.data.status == 'confirmed'))
                && request.resource.data.status == 'accepted' && canPrivate()
                && request.resource.data.get('offerAt', null) == resource.data.get('offerAt', null)
                && str(request.resource.data.ownerFirstName, 40)
                && request.resource.data.ownerPhone is string && request.resource.data.ownerPhone.matches('^[0-9]{7}$'))
            // An open trip: the owner offers to take it.
            || (resource.data.get('mode', 'direct') == 'queue' && resource.data.status == 'offering' && request.resource.data.status == 'interest'
                && canPrivate() && request.resource.data.offerAt == request.time
                && request.resource.data.ownerFirstName == '' && request.resource.data.ownerPhone == '')
            || (resource.data.get('mode', 'direct') == 'direct' && resource.data.status == 'offering' && request.resource.data.status == 'declined')
            || (resource.data.status == 'accepted' && request.resource.data.status == 'onboard')
            || (resource.data.status == 'onboard' && request.resource.data.status == 'arrived' && request.resource.data.arrivedAt == request.time))));
      allow delete: if false;
    }

    // An approved vehicle on the map while its owner has it available: no phone number.
    match /publicVehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.status == 'approved'
        && request.resource.data.keys().hasOnly(['ownerUid', 'type', 'colour', 'seats', 'firstName', 'priceBase', 'pricePerKm', 'at', 'heading', 'level', 'rider', 'since', 'updatedAt'])
        // Its place in the private queue: set now (switched on, or back from a trip), or kept.
        && (!('since' in request.resource.data) || request.resource.data.since == request.time
          || (resource != null && request.resource.data.since == resource.data.get('since', null)))
        && request.resource.data.get('rider', 'none') in ['none', 'man', 'woman', 'young']
        && request.resource.data.get('level', 'active') in ['active', 'rest', 'nap', 'sleep']
        && request.resource.data.ownerUid == request.auth.uid
        // Two checks: the person has the Private driver role, and the vehicle is approved.
        && canPrivate()
        && request.resource.data.type in ['car', 'van', 'pickup', 'motorbike', 'ebike']
        && str(request.resource.data.firstName, 40)
        && request.resource.data.at is list && request.resource.data.at.size() == 2
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (isStaff()
        || get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerUid == request.auth.uid);
    }

    match /publicTaxis/{taxiId} {
      allow read: if true;
      allow create, update: if adminOf(request.resource.data.get('centerId', 'main'))
        && (resource == null || adminOf(resource.data.get('centerId', 'main')))
        && request.resource.data.keys().hasOnly(['taxiNo', 'name', 'nameDv', 'suspended', 'seats', 'vehicleId', 'centerId'])
        && (!('centerId' in request.resource.data) || str(request.resource.data.centerId, 40))
        && (request.resource.data.get('vehicleId', null) == null || str(request.resource.data.vehicleId, 40))
        && (!('seats' in request.resource.data) || (request.resource.data.seats is int && request.resource.data.seats >= 1 && request.resource.data.seats <= 15))
        && str(request.resource.data.taxiNo, 4)
        && str(request.resource.data.name, 60)
        && str(request.resource.data.nameDv, 60)
        && request.resource.data.suspended is bool;
      allow delete: if adminOf(resource.data.get('centerId', 'main'));
    }

    // A center's queue: the order is a list of taxi ids (not personal data); passengers and drivers
    // need it for offers. Its staff change it; a driver who accepted a ride moves their own taxi to
    // the back, and nothing else.
    function queueWrite(c) {
      return request.resource.data.keys().hasOnly(['order', 'interested', 'updatedAt', 'updatedBy'])
        && request.resource.data.order is list && request.resource.data.order.size() <= 500
        && request.resource.data.interested is list && request.resource.data.interested.size() <= 500
        && (staffOf(c)
          || (resource != null && isDriver() && myCenter() == c
            && request.resource.data.order == resource.data.order.removeAll([myTaxi()]).concat([myTaxi()])
            && request.resource.data.interested == resource.data.interested.removeAll([myTaxi()])));
    }
    match /queue/state {
      allow read: if signedIn();
      allow create, update: if queueWrite('main');
    }
    match /queues/{centerId} {
      allow read: if signedIn();
      allow create, update: if exists(/databases/$(database)/documents/centers/$(centerId)) && queueWrite(centerId);
    }

    match /dispatches/{dispatchId} {
      allow read: if isPlatform() || staffOf(resource.data.centerId);
      allow create: if (staffOf(request.resource.data.get('centerId', 'main')) || (isDriver() && request.resource.data.taxi.id == myTaxi()))
        && request.resource.data.keys().hasOnly(['taxi', 'at', 'from', 'interested', 'call', 'reopened', 'undone', 'by', 'requestId', 'centerId'])
        && request.resource.data.at is int
        && request.resource.data.from is int
        && request.resource.data.reopened == false
        && request.resource.data.undone == false;
      allow update: if staffOf(resource.data.get('centerId', 'main'))
        && request.resource.data.get('centerId', 'main') == resource.data.get('centerId', 'main')
        && request.resource.data.keys().hasOnly(['taxi', 'at', 'from', 'interested', 'call', 'reopened', 'undone', 'by', 'requestId', 'centerId'])
        && request.resource.data.at is int
        && request.resource.data.from is int;
    }

    // One ride request per passenger: requests/{their uid}. A new request overwrites the old one.
    match /requests/{uid} {
      function next() {
        return request.resource.data;
      }
      function prev() {
        return resource.data;
      }
      function validShape() {
        return next().keys().hasOnly(['uid', 'name', 'mode', 'pickup', 'pickupAt', 'destination', 'destinationAt', 'phone', 'note',
            'status', 'offerTo', 'offerAt', 'skipped', 'acceptedBy', 'driverUid', 'price', 'km', 'arrivedAt', 'size', 'centerId', 'createdAt'])
          && (!('centerId' in next()) || str(next().centerId, 40))
          && next().get('size', 'small') in ['small', 'large']
          && next().uid == uid
          && str(next().name, 80)
          && next().mode in ['queue', 'direct']
          && str(next().pickup, 120) && next().pickup.size() > 0
          && str(next().destination, 120)
          && next().phone is string && next().phone.matches('^[0-9]{7}$')
          && str(next().note, 120)
          && (!('pickupAt' in next()) || (next().pickupAt is list && next().pickupAt.size() == 2))
          && (!('destinationAt' in next()) || (next().destinationAt is list && next().destinationAt.size() == 2))
          && next().status in ['offering', 'interest', 'confirmed', 'accepted', 'onboard', 'arrived', 'done', 'problem', 'expired', 'cancelled']
          && (next().get('price', null) == null || (next().price is number && next().price >= 0 && next().price <= 100000))
          && (next().get('km', null) == null || (next().km is number && next().km >= 0 && next().km <= 1000))
          && (!('arrivedAt' in next()) || next().arrivedAt is timestamp)
          && (next().offerTo == null || str(next().offerTo, 40))
          && next().offerAt is timestamp
          && next().skipped is list && next().skipped.size() <= 500
          && (next().acceptedBy == null || str(next().acceptedBy, 40))
          && (next().get('driverUid', null) == null || str(next().driverUid, 128));
      }
      // A step of a trip: the fields a step may change. The rest stay as they were (sameTrip).
      function stepShape() {
        return next().keys().hasOnly(['uid', 'name', 'mode', 'pickup', 'pickupAt', 'destination', 'destinationAt', 'phone', 'note',
            'status', 'offerTo', 'offerAt', 'skipped', 'acceptedBy', 'driverUid', 'price', 'km', 'arrivedAt', 'size', 'centerId', 'createdAt'])
          && next().status in ['offering', 'interest', 'confirmed', 'accepted', 'onboard', 'arrived', 'done', 'problem', 'expired', 'cancelled']
          && (!('arrivedAt' in next()) || next().arrivedAt is timestamp)
          && (next().offerTo == null || str(next().offerTo, 40))
          && next().offerAt is timestamp
          && next().skipped is list && next().skipped.size() <= 500
          && (next().acceptedBy == null || str(next().acceptedBy, 40))
          && (next().get('driverUid', null) == null || str(next().driverUid, 128));
      }
      // A fresh request: offered to one taxi (or nobody, if no taxi is free), just now.
      function isFresh() {
        return next().status in ['offering', 'expired']
          && next().offerAt == request.time
          && next().createdAt == request.time
          && next().skipped.size() == 0
          && next().acceptedBy == null
          && next().get('driverUid', null) == null
          && (next().status == 'expired' || (next().offerTo in queueOrder(center()) && (next().mode == 'direct' || fitsSize())));
      }
      // The same trip; the driver's account (driverUid, whose earnings) stays unless driverIs() says
      // otherwise: only the driver who offers or accepts sets it, to themselves.
      function sameTrip() {
        return sameTripAs(prev().get('driverUid', null));
      }
      function sameTripAs(driver) {
        // One diff instead of a check per field (rules stop at 1000 expressions). The total price is
        // fixed from the start.
        return next().get('driverUid', null) == driver
          && !next().diff(prev()).affectedKeys().hasAny(['uid', 'name', 'mode', 'pickup', 'destination', 'phone', 'note',
            'createdAt', 'pickupAt', 'destinationAt', 'price', 'km', 'size', 'centerId']);
      }
      // The request's taxi center (its queue and staff).
      function center() {
        return next().get('centerId', 'main');
      }
      function centerStaff() {
        return staffOf(prev().get('centerId', 'main'));
      }
      // A 7-10 seat trip is offered only to a 7-10 seat taxi.
      function fitsSize() {
        return next().get('size', 'small') == 'small'
          || get(/databases/$(database)/documents/publicTaxis/$(next().offerTo)).data.get('seats', 4) >= 7;
      }
      // After booking: the same trip, taxi and booking; only the step (and arrivedAt) change.
      function sameBooking() {
        return next().acceptedBy == prev().acceptedBy && next().offerTo == prev().offerTo
          && next().skipped == prev().skipped && next().offerAt == prev().offerAt && sameTrip();
      }
      // A taxi that may take a trip: not suspended, and (one at a time) its vehicle not out on
      // private hire. Reads the taxi once (rules stop at 1000 expressions).
      function freeTaxi(id) {
        let t = get(/databases/$(database)/documents/taxis/$(id)).data;
        return !('suspended' in t) && !exists(/databases/$(database)/documents/publicVehicles/$(t.get('vehicleId', '-')));
      }
      function myRide() {
        return isDriver() && prev().acceptedBy == myTaxi();
      }
      // How long the current step may wait (open trips: driver 20 s, passenger 60 s, the driver's
      // phone 30 s to complete a booking).
      function waited() {
        return (prev().status == 'offering' && request.time > prev().offerAt + duration.value(20, 's'))
          || (prev().status == 'interest' && request.time > prev().offerAt + duration.value(60, 's'))
          || (prev().status == 'confirmed' && request.time > prev().offerAt + duration.value(30, 's'));
      }
      // The trip stays with the same taxi, and only the step and its time change.
      function sameOffer() {
        return sameOfferAs(prev().get('driverUid', null));
      }
      function sameOfferAs(driver) {
        return sameTripAs(driver) && next().offerTo == prev().offerTo && next().skipped == prev().skipped
          && next().acceptedBy == null && next().offerAt == request.time;
      }
      // Move the offer on from the current taxi (passed, no thanks, or timed out) to the next, or expire.
      function movesOn() {
        return prev().status in ['offering', 'interest', 'confirmed']
          && sameTrip()
          && next().skipped == prev().skipped.concat([prev().offerTo])
          && next().offerAt == request.time
          && next().acceptedBy == null
          && (
            (next().status == 'expired' && next().offerTo == null)
            || (prev().mode == 'queue' && next().status == 'offering'
                && next().offerTo in queueOrder(center()) && !(next().offerTo in next().skipped) && fitsSize())
          );
      }

      allow read: if signedIn() && (uid == request.auth.uid || isPlatform() || staffOf(resource.data.get('centerId', 'main'))
        || (isDriver() && (resource.data.offerTo == myTaxi() || resource.data.acceptedBy == myTaxi())));

      allow create: if signedIn() && uid == request.auth.uid && validShape() && isFresh();

      // Each kind of change is told apart first by a cheap check (the new status, or a new
      // createdAt), so only one branch is checked in full (rules may evaluate 1000 expressions).
      // A new request is checked in full (validShape). Every other change is a step of the same trip:
      // each branch keeps the fixed fields (sameTrip), checked in full when the request was made, so
      // only the step's own fields are checked (stepShape), which keeps the count down.
      allow update: if signedIn() && (
        // The passenger: a new request.
        (next().createdAt == request.time && uid == request.auth.uid && validShape() && isFresh())
        || (stepShape() && (
        // The passenger (before pickup) or staff: cancel.
        (next().status == 'cancelled' && sameTrip()
            && (centerStaff() || (uid == request.auth.uid && prev().status in ['offering', 'interest', 'confirmed', 'accepted', 'expired'])))
        // The trip. The driver: picked up, then arrived at the destination.
        || (next().status == 'onboard' && prev().status == 'accepted' && myRide()
            && next().get('arrivedAt', null) == prev().get('arrivedAt', null) && sameBooking())
        || (next().status == 'arrived' && prev().status == 'onboard' && myRide()
            && next().arrivedAt == request.time && sameBooking())
        // The passenger: finished, or a problem. With no answer in 10 minutes, anyone involved
        // marks it done. Staff close a problem.
        || (next().status in ['done', 'problem'] && prev().status == 'arrived'
            && (uid == request.auth.uid
              || (next().status == 'done' && (myRide() || centerStaff()) && request.time > prev().arrivedAt + duration.value(10, 'm')))
            && next().arrivedAt == prev().arrivedAt && sameBooking())
        || (next().status == 'done' && prev().status == 'problem' && centerStaff()
            && next().get('arrivedAt', null) == prev().get('arrivedAt', null) && sameBooking())
        // On to the next taxi (or expired): once the step has waited its time (anyone involved);
        // the offered driver passing; or the passenger saying no thanks to a taxi that offered.
        || (next().skipped.size() == prev().skipped.size() + 1
            && ((waited() && (uid == request.auth.uid || centerStaff() || isDriver()))
              || (prev().status == 'offering' && isDriver() && prev().offerTo == myTaxi())
              || (prev().status == 'interest' && uid == request.auth.uid))
            && movesOn())
        // Open trip: the offered driver offers to take it (taxi must not be suspended).
        || (next().status == 'interest' && prev().status == 'offering' && prev().mode == 'queue'
            && isDriver() && prev().offerTo == myTaxi()
            && freeTaxi(prev().offerTo)
            && sameOfferAs(request.auth.uid))
        // Open trip: the passenger books the taxi that offered.
        || (next().status == 'confirmed' && prev().status == 'interest' && uid == request.auth.uid && sameOffer())
        // Booked (open trip), or a taxi the passenger picked on the map (direct): the driver
        // completes it; staff may complete a booked one for them.
        || (next().status == 'accepted'
            && (prev().status == 'confirmed' || (prev().status == 'offering' && prev().mode == 'direct'))
            && ((isDriver() && prev().offerTo == myTaxi()) || (centerStaff() && prev().status == 'confirmed'))
            && next().acceptedBy == prev().offerTo && next().offerTo == prev().offerTo
            && next().skipped == prev().skipped && next().offerAt == prev().offerAt
            && freeTaxi(prev().offerTo)
            // The driver's account: kept (the one who offered; staff completing a booking keep it),
            // or, if missing, set by the accepting driver to themselves (direct).
            && sameTripAs(next().get('driverUid', null))
            && (next().get('driverUid', null) == prev().get('driverUid', null)
              || (prev().get('driverUid', null) == null && next().driverUid == request.auth.uid && isDriver() && prev().offerTo == myTaxi())))
        ))
      );
    }

    // The taxi fare table: admins set it; everyone signed in reads it (the total before sending a trip).
    // Each center's fare table: config/fares for the first center, fares/{center} for the others.
    function faresWrite(c) {
      return adminOf(c)
        && request.resource.data.keys().hasOnly(['base', 'perKm', 'minimum', 'updatedBy', 'updatedAt'])
        && request.resource.data.base is number && request.resource.data.base >= 0 && request.resource.data.base <= 10000
        && request.resource.data.perKm is number && request.resource.data.perKm >= 0 && request.resource.data.perKm <= 10000
        && request.resource.data.minimum is number && request.resource.data.minimum >= 0 && request.resource.data.minimum <= 10000
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time;
    }
    match /fares/{centerId} {
      allow read: if signedIn();
      allow create, update: if exists(/databases/$(database)/documents/centers/$(centerId)) && faresWrite(centerId);
    }
    // Taxi centers: platform admins create them; a center's admins may rename theirs. Everyone
    // signed in reads them (the hire form lists them).
    match /centers/{centerId} {
      allow read: if signedIn();
      allow create, update: if (isPlatform() || (resource != null && adminOf(centerId)))
        && request.resource.data.keys().hasOnly(['name', 'nameDv', 'at', 'migrated', 'updatedBy', 'updatedAt'])
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 1
        && str(request.resource.data.nameDv, 60)
        && (request.resource.data.at == null || (request.resource.data.at is list && request.resource.data.at.size() == 2))
        && (isPlatform() || request.resource.data.get('migrated', false) == resource.data.get('migrated', false))
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time;
      allow delete: if isPlatform() && centerId != 'main';
    }
    match /config/fares {
      allow read: if signedIn();
      allow create, update: if adminOf('main')
        && request.resource.data.keys().hasOnly(['base', 'perKm', 'minimum', 'updatedBy', 'updatedAt'])
        && request.resource.data.base is number && request.resource.data.base >= 0 && request.resource.data.base <= 10000
        && request.resource.data.perKm is number && request.resource.data.perKm >= 0 && request.resource.data.perKm <= 10000
        && request.resource.data.minimum is number && request.resource.data.minimum >= 0 && request.resource.data.minimum <= 10000
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time;
    }

    // Recorded voice messages (Management -> Voice messages): a short audio clip per message and
    // language, recorded or uploaded by admins; everyone signed in plays them.
    match /voiceClips/{id} {
      allow read: if signedIn();
      allow create, update: if isPlatform()
        && id in ['tripNew-en', 'tripNew-dv', 'tripBooked-en', 'tripBooked-dv', 'offerReceived-en', 'offerReceived-dv']
        && request.resource.data.keys().hasOnly(['data', 'mime', 'by', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 480000
        && request.resource.data.mime is string && request.resource.data.mime.size() <= 60
        && request.resource.data.mime.matches('^audio/[a-z0-9.+-]+(;.*)?$')
        && request.resource.data.by == email()
        && request.resource.data.updatedAt == request.time;
      allow delete: if isPlatform();
    }

    // Manual queue changes (reorder / shuffle) by staff, each with a reason. A permanent log:
    // anyone on staff can add an entry for themselves, nobody can edit or delete one.
    match /queueChanges/{id} {
      allow read: if isPlatform() || staffOf(resource.data.centerId);
      allow create: if staffOf(request.resource.data.get('centerId', 'main'))
        && request.resource.data.keys().hasOnly(['centerId', 'at', 'by', 'kind', 'reason', 'note', 'before', 'after'])
        && request.resource.data.at == request.time
        && request.resource.data.by == email()
        && request.resource.data.kind in ['reorder', 'shuffle']
        && request.resource.data.reason in ['late', 'returned', 'correction', 'shift', 'other']
        && str(request.resource.data.note, 120)
        && (request.resource.data.reason != 'other' || request.resource.data.note.size() > 0)
        && request.resource.data.before is list && request.resource.data.before.size() <= 500
        && request.resource.data.after is list && request.resource.data.after.size() == request.resource.data.before.size();
      // Never edited; only, once, a platform admin gives an entry from before centers to the first.
      allow update: if isPlatform() && !('centerId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['centerId']) && request.resource.data.centerId == 'main';
      allow delete: if false;
    }

    // Each person's activity log (src/activity.ts): append-only, written by the person's own app or
    // by staff acting on them, read by the person and staff. Kept 90 days: a TTL policy on expireAt
    // deletes old entries. Never holds locations or phone numbers (short detail only).
    match /activity/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'detail', 'by', 'at', 'expireAt'])
        && request.resource.data.at == request.time
        && request.resource.data.by == email()
        && str(request.resource.data.detail, 80)
        && request.resource.data.uid is string
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(91, 'd')
        && request.resource.data.kind in ['roleChanged', 'vehicleApplied', 'vehicleEdited', 'vehicleApproved', 'vehicleRejected',
          'vehicleSuspended', 'vehicleLinked', 'availableOn', 'availableOff', 'bookingSent', 'bookingCancelled', 'bookingDone',
          'offerTaken', 'offerPassed', 'tripFinished', 'problemReported', 'rideFixed']
        && (request.resource.data.uid == request.auth.uid || isStaff());
      allow update, delete: if false;
    }

    // Each person's money account (src/account.ts, src/core/account.ts). Append-only. When a trip
    // finishes, the batch that marks it done also records Paid for the passenger and Earned for the
    // driver or owner, at the trip's fixed total, in cash. Each trip entry is checked against its
    // trip (read after the batch): done, the same price, the right people, and one per trip and side
    // (the id is the trip key and side, and entries are never updated). Staff add corrections, with
    // a reason. Read by the person and staff.
    match /accountEntries/{id} {
      function e() {
        return request.resource.data;
      }
      function tripDoc() {
        return getAfter(e().kind == 'taxi'
          ? /databases/$(database)/documents/requests/$(e().passengerUid)
          : /databases/$(database)/documents/privateRides/$(e().passengerUid)).data;
      }
      function tripEntryOk() {
        let t = tripDoc();
        let driver = e().kind == 'taxi' ? t.get('driverUid', null) : t.get('ownerUid', null);
        return t.status == 'done'
          && e().amount == t.price
          && e().tripKey == e().kind + '-' + e().passengerUid + '-' + string(t.createdAt.toMillis())
          && id == e().tripKey + '-' + e().side
          && ((e().side == 'paid' && e().uid == e().passengerUid) || (e().side == 'earned' && e().uid == driver))
          && (request.auth.uid == e().passengerUid || request.auth.uid == driver || isStaff());
      }
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn()
        && e().by == email() && e().at == request.time
        && e().method == 'cash' && e().amount is int && str(e().uid, 128) && e().uid.size() > 0
        && (
          (e().side in ['earned', 'paid']
            && e().keys().hasOnly(['uid', 'passengerUid', 'side', 'amount', 'method', 'kind', 'tripKey', 'note', 'by', 'at'])
            && e().keys().hasAll(['uid', 'passengerUid', 'side', 'amount', 'method', 'kind', 'tripKey', 'note', 'by', 'at'])
            && e().kind in ['taxi', 'private'] && e().note == '' && e().amount > 0
            && str(e().passengerUid, 128) && e().passengerUid.size() > 0
            && tripEntryOk())
          || (e().side == 'correction' && isStaff()
            && e().keys().hasOnly(['uid', 'side', 'amount', 'method', 'kind', 'tripKey', 'note', 'by', 'at'])
            && e().keys().hasAll(['uid', 'side', 'amount', 'method', 'kind', 'tripKey', 'note', 'by', 'at'])
            && e().kind == null && e().tripKey == ''
            && e().amount != 0 && e().amount >= -100000 && e().amount <= 100000
            && str(e().note, 120) && e().note.size() >= 3)
        );
      allow update, delete: if false;
    }

    // ---- Dhivehi corpus (src/core/corpus.ts, src/corpus.ts): the owner's own research, never
    // imported from a dictionary. Words grouped by root, dialect forms, example sentences and the
    // sources cited. Corpus editors are platform admins and anyone whose roles entry has corpus: true.
    // Reading is editors only for now: open it up by changing corpusReader() alone.
    // Every write also adds a corpusHistory entry in the same batch (the document names it in
    // historyId, checked with getAfter); history is append-only. Editors may delete corpus documents:
    // the history keeps the before snapshot.
    function corpusEditor() {
      // The corpus flag first: a corpus-only entry may have no role field.
      return signedIn() && exists(roleDoc())
        && (get(roleDoc()).data.get('corpus', false) == true || isPlatform());
    }
    function corpusReader() {
      return corpusEditor();
    }
    // '' (where allowed) or text with Thaana letters (U+0780 to U+07BF).
    function corpusThaana(v, max, allowEmpty) {
      return v is string && v.size() <= max
        && ((allowEmpty && v == '') || v.matches('(?s).*[\\x{0780}-\\x{07BF}].*'));
    }
    function corpusList(v, max) {
      return v is list && v.size() <= max;
    }
    function corpusDialect(v) {
      // Keep in step with DIALECTS in src/core/corpus.ts.
      return v in ['male', 'addu', 'huvadhu', 'mulaku', 'naifaru'];
    }
    // Who and when: created once, updated on every write, always by the writer.
    function corpusMeta(d) {
      return d.updatedBy == email() && d.updatedAt == request.time
        && (resource == null
          ? d.createdBy == email() && d.createdAt == request.time
          : d.createdBy == resource.data.createdBy && d.createdAt == resource.data.createdAt);
    }
    function corpusVerified(d) {
      return d.verified is bool && d.verifiedBy is string
        && ((d.verified == false && d.verifiedBy == '')
          || (d.verified == true && (d.verifiedBy == email()
            || (resource != null && resource.data.get('verified', false) == true && d.verifiedBy == resource.data.get('verifiedBy', '')))));
    }
    // The history entry written in the same batch, for this document.
    function corpusLogged(col, docId) {
      let h = getAfter(/databases/$(database)/documents/corpusHistory/$(request.resource.data.historyId)).data;
      return h.collection == col && h.docId == docId && h.by == email() && h.at == request.time;
    }
    function corpusMetaKeys() {
      return ['createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'historyId'];
    }
    match /corpusRoots/{id} {
      function ok(d) {
        return d.keys().hasOnly(['thaana', 'latin', 'meaningEn', 'meaningDv', 'origin', 'notes', 'sources', 'verified', 'verifiedBy'].concat(corpusMetaKeys()))
          && d.keys().hasAll(['thaana', 'latin', 'meaningEn', 'meaningDv', 'origin', 'notes', 'sources', 'verified', 'verifiedBy'].concat(corpusMetaKeys()))
          && d.historyId is string
          && corpusThaana(d.thaana, 80, false)
          && str(d.latin, 80) && str(d.meaningEn, 500) && str(d.meaningDv, 500) && str(d.notes, 1000)
          && d.origin in ['', 'sanskrit', 'pali', 'arabic', 'persian', 'urdu', 'hindi', 'english', 'portuguese', 'other']
          && corpusList(d.sources, 30)
          && corpusVerified(d) && corpusMeta(d) && corpusLogged('corpusRoots', id);
      }
      allow read: if corpusReader();
      allow create, update: if corpusEditor() && ok(request.resource.data);
      allow delete: if corpusEditor();
    }
    match /corpusWords/{wordId} {
      // Thaana may be empty for a draft known only by its Latin spelling.
      function ok(d) {
        return d.keys().hasOnly(['thaana', 'latin', 'rootId', 'pos', 'meaningEn', 'meaningDv', 'category', 'scientificName', 'partUsed', 'notes', 'sources', 'verified', 'verifiedBy'].concat(corpusMetaKeys()))
          && d.keys().hasAll(['thaana', 'latin', 'rootId', 'pos', 'meaningEn', 'meaningDv', 'category', 'scientificName', 'partUsed', 'notes', 'sources', 'verified', 'verifiedBy'].concat(corpusMetaKeys()))
          && d.historyId is string
          && corpusThaana(d.thaana, 80, true)
          && str(d.latin, 80) && (d.thaana != '' || d.latin != '')
          && str(d.rootId, 128)
          && d.pos in ['', 'noun', 'verb', 'adjective', 'adverb', 'pronoun', 'particle', 'other']
          && str(d.meaningEn, 500) && str(d.meaningDv, 500)
          && d.category in ['', 'medicine', 'plant', 'vehicle', 'place', 'food', 'sea', 'general', 'other']
          && str(d.scientificName, 80)
          && d.partUsed in ['', 'seed', 'leaf', 'root', 'bark', 'fruit', 'flower', 'oil', 'whole', 'other']
          && str(d.notes, 1000) && corpusList(d.sources, 30)
          && corpusVerified(d) && corpusMeta(d) && corpusLogged('corpusWords', wordId);
      }
      allow read: if corpusReader();
      allow create, update: if corpusEditor() && ok(request.resource.data);
      allow delete: if corpusEditor();

      match /forms/{dialect} {
        function formOk(d) {
          return corpusDialect(dialect)
            && d.keys().hasOnly(['thaana', 'latin', 'pronunciation', 'notes', 'speaker', 'sources'].concat(corpusMetaKeys()))
            && d.keys().hasAll(['thaana', 'latin', 'pronunciation', 'notes', 'speaker', 'sources'].concat(corpusMetaKeys()))
            && d.historyId is string
            && corpusThaana(d.thaana, 80, true)
            && str(d.latin, 80) && str(d.pronunciation, 200) && str(d.notes, 1000)
            // A short label like 'elder, Hithadhoo': never a full name or phone number.
            && str(d.speaker, 60) && !d.speaker.matches('.*([0-9]{5,}|@).*')
            && corpusList(d.sources, 30)
            && corpusMeta(d) && corpusLogged('corpusForms', wordId + '/' + dialect)
            && existsAfter(/databases/$(database)/documents/corpusWords/$(wordId));
        }
        allow read: if corpusReader();
        allow create, update: if corpusEditor() && formOk(request.resource.data);
        allow delete: if corpusEditor();
      }
    }
    // Every word's forms in one query (collectionGroup('forms')): the word list's dialect counts and
    // search, and the export. Read only; writes go through corpusWords/{wordId}/forms above.
    match /{path=**}/forms/{dialect} {
      allow read: if corpusReader();
    }
    match /corpusSentences/{id} {
      function ok(d) {
        return d.keys().hasOnly(['thaana', 'translationEn', 'dialect', 'wordIds', 'sources', 'notes'].concat(corpusMetaKeys()))
          && d.keys().hasAll(['thaana', 'translationEn', 'dialect', 'wordIds', 'sources', 'notes'].concat(corpusMetaKeys()))
          && d.historyId is string
          && corpusThaana(d.thaana, 500, false)
          && str(d.translationEn, 500) && str(d.notes, 1000)
          && (d.dialect == '' || corpusDialect(d.dialect))
          && corpusList(d.wordIds, 50) && corpusList(d.sources, 30)
          && corpusMeta(d) && corpusLogged('corpusSentences', id);
      }
      allow read: if corpusReader();
      allow create, update: if corpusEditor() && ok(request.resource.data);
      allow delete: if corpusEditor();
    }
    match /corpusSources/{id} {
      function ok(d) {
        return d.keys().hasOnly(['kind', 'title', 'author', 'year', 'details', 'permission'].concat(corpusMetaKeys()))
          && d.keys().hasAll(['kind', 'title', 'author', 'year', 'details', 'permission'].concat(corpusMetaKeys()))
          && d.historyId is string
          && d.kind in ['book', 'list', 'person', 'fieldwork', 'website', 'other']
          && str(d.title, 200) && d.title.size() > 0
          && str(d.author, 200) && str(d.year, 20) && str(d.details, 300) && str(d.permission, 200)
          && corpusMeta(d) && corpusLogged('corpusSources', id);
      }
      allow read: if corpusReader();
      allow create, update: if corpusEditor() && ok(request.resource.data);
      allow delete: if corpusEditor();
    }
    // Append-only: created by an editor, as themselves, now; never changed or deleted.
    match /corpusHistory/{id} {
      allow read: if corpusReader();
      allow create: if corpusEditor()
        && request.resource.data.keys().hasOnly(['collection', 'docId', 'action', 'before', 'after', 'by', 'at'])
        && request.resource.data.keys().hasAll(['collection', 'docId', 'action', 'before', 'after', 'by', 'at'])
        && request.resource.data.by == email()
        && request.resource.data.at == request.time
        && request.resource.data.collection in ['corpusRoots', 'corpusWords', 'corpusForms', 'corpusSentences', 'corpusSources']
        && str(request.resource.data.docId, 300)
        && request.resource.data.action in ['create', 'update', 'delete', 'verify']
        && (request.resource.data.before == null || request.resource.data.before is map)
        && (request.resource.data.after == null || request.resource.data.after is map);
      allow update, delete: if false;
    }

    // ---- TaxiQ Game (plans/game-mode.md). Completely separate from the real service: play money,
    // game cars and players only; nothing here touches taxis, the queue, dispatches or roles.
    // games/world is the shared TaxiQ World: created once by whoever opens it first, always running,
    // nobody can change, pause or end it. Other games are private worlds run by their host.
    function gameDoc(gameId) {
      return getAfter(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function gameKeys() {
      return ['name', 'code', 'seed', 'hostUid', 'hostName', 'status', 'preset', 'bots', 'createdAt', 'startedAt', 'pausedMs', 'pausedAt'];
    }
    // The device that runs a world's ride service holds its lease (games/{id}/engine/lease).
    function isEngine(gameId) {
      let lease = get(/databases/$(database)/documents/games/$(gameId)/engine/lease).data;
      return lease.uid == request.auth.uid && lease.until > request.time;
    }
    function inGame(gameId) {
      return exists(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid));
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(gameKeys())
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && str(request.resource.data.hostName, 80)
        && request.resource.data.code is string && request.resource.data.code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && request.resource.data.seed == gameId
        && request.resource.data.preset in ['small', 'standard', 'large']
        && request.resource.data.bots is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.pausedMs == 0
        && request.resource.data.pausedAt == null
        && (gameId == 'world'
          ? request.resource.data.hostUid == 'world' && request.resource.data.status == 'running'
            && request.resource.data.startedAt == request.time && request.resource.data.bots == true
          : request.resource.data.hostUid == request.auth.uid && request.resource.data.status == 'lobby'
            && request.resource.data.startedAt == null);
      // Only the host changes a private world: start, pause, resume, end. The shared world never changes.
      allow update: if signedIn() && gameId != 'world' && resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(gameKeys())
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['lobby', 'running', 'paused', 'ended']
        && request.resource.data.preset in ['small', 'standard', 'large']
        && request.resource.data.pausedMs is int && request.resource.data.pausedMs >= resource.data.pausedMs;
      allow delete: if false;

      // Each player writes only their own entry: name, role, online, where to wait, heartbeat.
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'joinedAt', 'online', 'waitLat', 'waitLng', 'waitT', 'beatAt'])
          && str(request.resource.data.name, 80)
          && request.resource.data.role in ['citizen', 'driver', 'operator', 'owner']
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.get('online', false) is bool
          && request.resource.data.get('waitT', 0) is number
          && gameDoc(gameId).status in ['lobby', 'running', 'paused'];
        allow delete: if signedIn() && uid == request.auth.uid;
      }

      // The world's people, made once with the world and never made again.
      match /world/{docId} {
        allow read: if signedIn();
        allow create: if signedIn() && docId == 'roster'
          && request.resource.data.keys().hasOnly(['drivers', 'citizens', 'centers'])
          && request.resource.data.drivers is list && request.resource.data.drivers.size() <= 100
          && request.resource.data.citizens is list && request.resource.data.citizens.size() <= 200
          && request.resource.data.centers is list && request.resource.data.centers.size() <= 10
          && (gameId == 'world' || gameDoc(gameId).hostUid == request.auth.uid);
        allow update, delete: if false;
      }

      // Who runs the ride service now. A player of the world (the host, for a private world) takes
      // the lease when it is free or theirs, for up to a minute at a time.
      match /engine/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && docId == 'lease'
          && request.resource.data.keys().hasOnly(['uid', 'until'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.until is timestamp
          && request.resource.data.until <= request.time + duration.value(60, 's')
          && (resource == null || resource.data.uid == request.auth.uid || resource.data.until < request.time)
          && (gameId == 'world' ? inGame(gameId) : gameDoc(gameId).hostUid == request.auth.uid);
        allow delete: if false;
      }

      // Cars: written only by the engine.
      match /cars/{carNo} {
        allow read: if signedIn();
        allow create, update: if signedIn() && isEngine(gameId)
          && carNo.matches('^[0-9]{1,3}$')
          && request.resource.data.keys().hasOnly(['driverUid', 'plan', 'queuedAt', 'waitT'])
          && request.resource.data.plan is map
          && request.resource.data.queuedAt is number;
        allow delete: if false;
      }

      // Money (G3): only the engine writes the money head, wallets and ledger. Everyone in the world
      // can read them (an open economy). Ledger entries are append-only: never changed or deleted.
      match /money/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && isEngine(gameId) && docId == 'state'
          && request.resource.data.keys().hasOnly(['bank', 'island', 'charity', 'outsideIn', 'outsideOut', 'seq', 'lastHash'])
          && request.resource.data.seq is int
          && (resource == null || request.resource.data.seq >= resource.data.seq);
        allow delete: if false;
      }
      match /wallets/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && isEngine(gameId)
          && request.resource.data.keys().hasOnly(['cash', 'job', 'car', 'deals', 'day', 'lastDay'])
          && request.resource.data.cash is number
          && request.resource.data.car in ['none', 'rent', 'own', 'bank'];
        allow delete: if false;
      }
      match /ledger/{seq} {
        allow read: if signedIn();
        allow create: if signedIn() && isEngine(gameId)
          && request.resource.data.keys().hasOnly(['seq', 'day', 'from', 'to', 'amount', 'reason', 'prev', 'hash', 'createdAt'])
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.hash is string && request.resource.data.prev is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      // A player asks for a job, to quit, or a KD-Bank deal; the engine decides.
      match /applications/{appId} {
        allow read: if signedIn();
        allow create: if signedIn() && inGame(gameId)
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'days', 'amount', 'status', 'reason', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['job', 'quit', 'murabaha', 'ijara', 'qard']
          && request.resource.data.days is int && request.resource.data.amount is number
          && request.resource.data.status == 'new' && request.resource.data.reason == ''
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && isEngine(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason'])
          && resource.data.status == 'new'
          && request.resource.data.status in ['approved', 'declined'];
        allow delete: if false;
      }

      // Rides. A player books their own; the engine books bot rides and runs every ride. The driver
      // the ride is offered to only answers it; the rider may cancel while it is still searching.
      match /trips/{tripId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['riderUid', 'riderName', 'bot', 'pLat', 'pLng', 'pName', 'dLat', 'dLng', 'dName', 'status', 'createdT', 'offerCar', 'offerT', 'response', 'declined', 'carNo', 'driverName', 'driverUid', 't0', 'dPick', 'dTotal', 'km', 'fare', 'doneT', 'createdAt'])
          && request.resource.data.status == 'searching'
          && request.resource.data.offerCar == null && request.resource.data.carNo == null && request.resource.data.fare == null
          && request.resource.data.pLat is number && request.resource.data.pLng is number
          && request.resource.data.dLat is number && request.resource.data.dLng is number
          && str(request.resource.data.pName, 80) && str(request.resource.data.dName, 80) && str(request.resource.data.riderName, 80)
          && request.resource.data.createdAt == request.time
          && (request.resource.data.bot == true
            ? isEngine(gameId) && request.resource.data.riderUid == 'bot'
            : request.resource.data.riderUid == request.auth.uid && inGame(gameId));
        allow update: if signedIn() && (
          (isEngine(gameId)
            && request.resource.data.riderUid == resource.data.riderUid
            && request.resource.data.bot == resource.data.bot
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status in ['searching', 'assigned', 'done', 'cancelled', 'expired'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response'])
            && resource.data.status == 'searching'
            && request.resource.data.response in ['accept', 'decline']
            && get(/databases/$(database)/documents/games/$(gameId)/cars/$(string(resource.data.offerCar))).data.driverUid == request.auth.uid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'searching' && request.resource.data.status == 'cancelled'
            && resource.data.riderUid == request.auth.uid));
        allow delete: if false;
      }
    }

    // Join code -> private world. Created once with the world; a taken code fails (create only), so
    // the app tries another.
    match /gameCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && request.resource.data.keys().hasOnly(['gameId', 'hostUid'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.gameId is string
        // The code must point at a game created in the same write, carrying this code and host.
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.code == code
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.hostUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Live Dhivehi translation fixes (Admin → Translations). Everyone reads them (they're UI text);
    // only admins and devs change them. The app renders them as plain text, never as HTML.
    match /translations/{lang} {
      allow read: if lang in ['dv'];
      allow write: if isAdmin() && lang in ['dv']
        && request.resource.data.keys().hasOnly(['entries', 'updatedBy', 'updatedAt'])
        && request.resource.data.entries is map
        && request.resource.data.entries.size() <= 600
        && request.resource.data.updatedBy == email();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
