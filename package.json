{
  "name": "taxiq",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "pnpm build && firebase deploy --only hosting",
    "rules": "firebase deploy --only firestore:rules,firestore:indexes --project kd-taxiq",
    "release": "pnpm build && firebase deploy --only hosting,firestore:rules,firestore:indexes --project kd-taxiq",
    "test:rules": "firebase emulators:exec --only firestore --project kd-taxiq \"node scripts/rules/game-rules.check.mjs\""
  },
  "dependencies": {
    "@fontsource/noto-sans-thaana": "^5.3.0",
    "firebase": "^13.2.0",
    "lucide-react": "1.61.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
