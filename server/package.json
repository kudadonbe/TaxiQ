{
  "name": "@taxiq/server",
  "private": true,
  "version": "3.0.0-dev",
  "type": "module",
  "description": "TaxiQ v3 API server: core engine + PostgreSQL, for the VPS",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
